{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "origin", "service", "nginx"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "uriStyle": {"type": "string", "enum": ["prefix", "suffix"]},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}},
    "origin": {
      "type": "object",
      "required": ["host", "port"],
      "properties": {
        "host": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "nginx": {
      "type": "object",
      "required": ["workerConnections", "maxConcurrentImageRequests", "cache", "imageFilter"],
      "properties": {
        "workerConnections": {"type": "integer", "minimum": 64, "maximum": 65535},
        "maxConcurrentImageRequests": {"type": "integer", "minimum": 1, "maximum": 1024},
        "cache": {
          "type": "object",
          "required": ["maxSize", "inactive", "validity", "emptyDirSizeLimit"],
          "properties": {
            "maxSize": {"type": "string", "pattern": "^[1-9][0-9]*(k|K|m|M|g|G)$"},
            "inactive": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h|d|w|M|y)$"},
            "validity": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h|d|w|M|y)$"},
            "emptyDirSizeLimit": {"type": "string", "minLength": 1}
          }
        },
        "imageFilter": {
          "type": "object",
          "required": ["buffer"],
          "properties": {
            "buffer": {"type": "string", "pattern": "^[1-9][0-9]*(k|K|m|M|g|G)$"}
          }
        },
        "tempSizeLimit": {"type": "string", "minLength": 1},
        "tmpSizeLimit": {"type": "string", "minLength": 1},
        "runSizeLimit": {"type": "string", "minLength": 1}
      }
    },
    "networkPolicy": {"type": "object", "required": ["enabled", "origin", "extraEgress"], "properties": {"enabled": {"type": "boolean"}, "origin": {"type": "object", "required": ["namespaceLabels", "podLabels"], "properties": {"namespaceLabels": {"type": "object", "additionalProperties": {"type": "string"}}, "podLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}}}, "extraEgress": {"type": "array", "items": {"type": "object", "properties": {"to": {"type": "array", "items": {"type": "object"}}, "ports": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": false}}}}
  }
}
